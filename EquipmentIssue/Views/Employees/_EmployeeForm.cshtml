@model EquipmentIssue.ViewModels.EmployeeForm
<partial name="_Errors" />
<form method="post" class="card card-body" style="max-width: 640px">
    <div class="mb-3">
        <label asp-for="FullName" class="form-label"></label>
        <input asp-for="FullName" class="form-control" placeholder="Фамилия Имя Отчество" />
    </div>
    <div class="mb-3">
        <label asp-for="PersonnelNumber" class="form-label"></label>
        <input asp-for="PersonnelNumber" class="form-control" placeholder="например, T-1009" />
    </div>
    <div class="mb-3">
        <label asp-for="Department" class="form-label"></label>
        <input asp-for="Department" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Position" class="form-label"></label>
        <input asp-for="Position" class="form-control" />
    </div>
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Сохранить</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Отмена</a>
    </div>
</form>
