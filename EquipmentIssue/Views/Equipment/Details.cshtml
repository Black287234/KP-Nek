@model Equipment
@{
    ViewData["Title"] = Model.Name;
}
<h1 class="h3 mb-3">@Model.Name</h1>
<dl class="row">
    <dt class="col-sm-3">Инвентарный номер</dt><dd class="col-sm-9">@Model.InventoryNumber</dd>
    <dt class="col-sm-3">Категория</dt><dd class="col-sm-9">@Model.Category</dd>
    <dt class="col-sm-3">Серийный номер</dt><dd class="col-sm-9">@(Model.SerialNumber ?? "—")</dd>
    <dt class="col-sm-3">Состояние</dt><dd class="col-sm-9">@Model.Condition.DisplayName()</dd>
    <dt class="col-sm-3">Списано</dt><dd class="col-sm-9">@(Model.IsWrittenOff ? "да" : "нет")</dd>
</dl>
<a class="btn btn-outline-secondary" asp-action="Index">К списку</a>
