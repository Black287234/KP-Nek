@model EquipmentIssue.ViewModels.IssueForm
@{
    ViewData["Title"] = "Выдача оборудования";
    var equipmentList = ViewData["EquipmentList"] as List<SelectListItem> ?? new List<SelectListItem>();
    var employeeList = ViewData["EmployeeList"] as List<SelectListItem> ?? new List<SelectListItem>();
}
<h1 class="h3 mb-1">Выдача оборудования сотруднику</h1>
<p class="text-muted">В списке только оборудование на складе, которое можно выдать (не требует ремонта, не списано), и работающие сотрудники.</p>
<partial name="_Errors" />
<form method="post" class="card card-body" style="max-width: 720px">
    <div class="mb-3">
        <label asp-for="EquipmentId" class="form-label"></label>
        <select asp-for="EquipmentId" asp-items="equipmentList" class="form-select">
            <option value="">— выберите оборудование —</option>
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="EmployeeId" class="form-label"></label>
        <select asp-for="EmployeeId" asp-items="employeeList" class="form-select">
            <option value="">— выберите сотрудника —</option>
        </select>
    </div>
    <div class="mb-3" style="max-width: 220px">
        <label asp-for="Date" class="form-label"></label>
        <input asp-for="Date" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Comment" class="form-label"></label>
        <input asp-for="Comment" class="form-control" placeholder="например, «для удалённой работы»" />
    </div>
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Оформить выдачу</button>
        <a class="btn btn-outline-secondary" asp-controller="Equipment" asp-action="Index">Отмена</a>
    </div>
</form>
