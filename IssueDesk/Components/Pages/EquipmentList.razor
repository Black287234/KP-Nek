@page "/equipment"
@inject IReadOnlyList<Equipment> Items

<PageTitle>Оборудование</PageTitle>
<h1>Перечень оборудования</h1>
<p class="lead">Единиц оборудования: @Items.Count</p>

<table class="register">
    <thead><tr><th>Инв. номер</th><th>Наименование</th><th>Вид</th><th>Серийный номер</th><th>Состояние</th></tr></thead>
    <tbody>
    @foreach (var e in Items)
    {
        <tr>
            <td><a href="equipment/@e.Id">@e.InventoryNumber</a></td>
            <td>@e.Name</td>
            <td>@Names.Of(e.Kind)</td>
            <td>@(e.SerialNumber ?? "—")</td>
            <td>@Names.Of(e.Condition)</td>
        </tr>
    }
    </tbody>
</table>
