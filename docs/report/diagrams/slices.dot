digraph G {
  graph [rankdir=TB, fontname="Liberation Serif", bgcolor=white, nodesep=0.3, ranksep=0.5];
  node [shape=box, style="rounded,filled", fillcolor=white, color="#1b2a41", penwidth=1.3, fontname="Liberation Serif", fontsize=13];
  edge [arrowhead=none, color="#9aa3b1", penwidth=1.3];
  root [label="Features — функции модуля", fillcolor="#1b2a41", fontcolor=white, fontsize=14];
  e [label="Equipment\nоборудование", fillcolor="#f6e9ec", color="#7b2335"];
  p [label="Employees\nсотрудники", fillcolor="#f6e9ec", color="#7b2335"];
  i [label="Issuing\nвыдача и возврат", fillcolor="#f6e9ec", color="#7b2335"];
  o [label="Overview\nглавная", fillcolor="#f6e9ec", color="#7b2335"];
  root -> {e p i o};
  inside [label="В каждой папке:\n• страницы (.razor)\n• обработчики действий (выдать, вернуть, сохранить)\n• настройка таблицы базы данных", shape=note, fillcolor="#eef1f6", fontsize=12];
  i -> inside [style=dashed];
}
