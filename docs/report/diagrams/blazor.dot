digraph G {
  graph [rankdir=TB, fontname="Liberation Serif", bgcolor=white, nodesep=1.2, ranksep=0.6];
  node [shape=box, style="rounded,filled", fillcolor=white, color="#1b2a41", penwidth=1.3, fontname="Liberation Serif", fontsize=14, height=0.9];
  edge [fontname="Liberation Serif", fontsize=12, color="#1b2a41", penwidth=1.2];
  b [label="Браузер\n(страница)", fillcolor="#eef1f6"];
  s [label="Сервер:\nкомпоненты .razor"];
  h [label="Обработчики:\nвыдать, вернуть …"];
  d [label="База данных\nSQLite", shape=cylinder, fillcolor="#f6e9ec", color="#7b2335"];
  b -> s [label=" щелчки, ввод\n(SignalR) ", dir=both];
  s -> h; d -> h [dir=back];
  {rank=same; b; s}
  {rank=same; d; h}
}
