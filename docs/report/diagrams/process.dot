digraph G {
  graph [rankdir=LR, fontname="Liberation Serif", bgcolor=white, nodesep=0.4, ranksep=0.45];
  node [fontname="Liberation Serif", fontsize=13, shape=box, style="rounded,filled", fillcolor=white, color="#1b2a41", penwidth=1.3];
  edge [fontname="Liberation Serif", fontsize=12, color="#1b2a41", penwidth=1.2];
  a [label="Сотрудник\nпросит\nоборудование", fillcolor="#eef1f6"];
  b [label="Можно\nвыдать?", shape=diamond, fillcolor="#f6e9ec", color="#7b2335"];
  c [label="Выдача:\nдата, срок,\nсостояние"];
  d [label="Сотрудник\nпользуется", fillcolor="#eef1f6"];
  e [label="Возврат:\nосмотр,\nсостояние"];
  f [label="Исправно?", shape=diamond, fillcolor="#f6e9ec", color="#7b2335"];
  g [label="На склад"];
  h [label="Описать\nнеисправность,\nв ремонт"];
  x [label="Отказ с причиной", fillcolor="#f6e9ec", color="#7b2335"];
  a -> b; b -> c [label="да"]; b -> x [label="нет"]; c -> d -> e -> f; f -> g [label="да"]; f -> h [label="нет"];
}
