digraph G {
  graph [rankdir=LR, fontname="Liberation Serif", bgcolor=white, nodesep=0.6, ranksep=1.2];
  node [shape=plain, fontname="Liberation Serif", fontsize=14];
  edge [fontname="Liberation Serif", fontsize=13, dir=both, arrowtail=tee, arrowhead=crow, color="#1b2a41", penwidth=1.3];
  Eq [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="6" color="#1b2a41">
    <tr><td bgcolor="#1b2a41"><font color="white"><b>Оборудование</b></font></td></tr>
    <tr><td align="left" balign="left">Инвентарный номер<br/>Наименование, вид<br/>Серийный номер<br/>Состояние<br/>Дата списания</td></tr></table>>];
  As [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="6" color="#7b2335">
    <tr><td bgcolor="#7b2335"><font color="white"><b>Закрепление</b> (выдача — возврат)</font></td></tr>
    <tr><td align="left" balign="left">Оборудование, сотрудник<br/>Дата выдачи, состояние при выдаче<br/>Вернуть до<br/>Дата возврата, состояние при возврате</td></tr>
    <tr><td align="left" bgcolor="#f6e9ec">Нет даты возврата — оборудование у сотрудника</td></tr></table>>];
  Em [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="6" color="#1b2a41">
    <tr><td bgcolor="#1b2a41"><font color="white"><b>Сотрудник</b></font></td></tr>
    <tr><td align="left" balign="left">Табельный номер<br/>Фамилия, имя, отчество<br/>Должность, подразделение<br/>Дата увольнения</td></tr></table>>];
  Eq -> As [label="1 : N"]; Em -> As [label="1 : N"];
}
