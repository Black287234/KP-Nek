digraph G {
  graph [rankdir=LR, fontname="Liberation Serif", bgcolor=white, nodesep=0.8, ranksep=1.1];
  node [shape=box, style="rounded,filled", fillcolor="#eef1f6", color="#1b2a41", penwidth=1.3, fontname="Liberation Serif", fontsize=15, width=2.2, height=0.9];
  edge [fontname="Liberation Serif", fontsize=13, color="#1b2a41", penwidth=1.3];
  stock [label="На складе"];
  held [label="У сотрудника", fillcolor="#f6e9ec", color="#7b2335"];
  repair [label="Требует\nремонта", fillcolor="#fbf3e0"];
  off [label="Списано", fillcolor="#e7e9ee"];
  stock -> held [label="выдача"];
  held -> stock [label="возврат"];
  held -> repair [label="возврат\nс неисправностью"];
  repair -> stock [label="после ремонта"];
  stock -> off [label="списание"];
  {rank=same; repair; off}
}
